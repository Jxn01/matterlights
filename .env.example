# Settings shared by every OS this checkout runs on. Per-OS values -- the
# RGB_PUBLISH_SOCKET, an explicit LOG_PATH, capture tuning -- go in .env.linux
# or .env.windows beside this file, which override it on that OS. Every setting,
# its default and the precedence rules: README.md -> Configuration.

# Home Assistant connection
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-your-long-lived-access-token

# Lights to control in order
HA_LIGHT_ENTITIES=light.example_primary_left,light.example_primary_right,light.example_secondary_left,light.example_secondary_right
LIGHT_ZONE_LAYOUT=top-center,bottom-left,bottom-right,bottom-center
# The zone layout, preview override and playback state default to
# .matterlights-<kind>.<os>.json beside this file -- one per OS, because a
# layout for one OS's screens means nothing on the other. Leave LIGHT_ZONE_FILE
# and CONTROL_STATE_FILE unset; set one only in an .env.<os> overlay, never
# here, or both OSes will share (and overwrite) it.

# Playback
# Autonomous (screen sync) vs custom (static color / pattern) is toggled live
# from Home Assistant (HA_MODE_ENTITY) and stored in CONTROL_STATE_FILE.
# Turn the lights off when the monitor goes to sleep (set false to keep custom
# colors on while the screen is asleep). Driven by the real display power state:
# GUID_CONSOLE_DISPLAY_STATE on Windows, Mutter's PowerSaveMode on Linux.
RESPECT_DISPLAY_SLEEP=true
# Turn the lights off when the machine shuts down, restarts, or logs off.
# This is only the first of three layers -- see "Shutdown, restart and logoff"
# in the README for the SYSTEM-level layer (a scheduled task on Windows, a
# system unit on Linux) and the Home Assistant fallback.
TURN_OFF_ON_SHUTDOWN=true
# How long the session-end turn-off waits for Home Assistant. Deliberately
# longer than REQUEST_TIMEOUT_SECONDS: that one is tuned for a loop that retries
# every tick, while this gets a single attempt before the process is killed.
SESSION_END_TIMEOUT_SECONDS=10.0

# Home Assistant fallback: the sync loop refreshes this entity, and an HA
# automation turns the lights off when it goes stale. This is the only layer
# that survives a crash, a hard reset or a power cut. Empty disables it.
HEARTBEAT_ENTITY_ID=sensor.matterlights_heartbeat
HEARTBEAT_INTERVAL_SECONDS=30.0

# The Lights and RGB master switches, mirrored both ways to on/off helpers
# in Home Assistant. Empty mirrors nothing. A new input_boolean starts OFF and
# Home Assistant wins the first reading -- set the helpers before enabling.
HA_LIGHTS_SWITCH_ENTITY=
HA_RGB_SWITCH_ENTITY=
HA_SWITCH_POLL_SECONDS=1.0

# Two machines, one set of bulbs: an entity naming which instance drives them,
# and the value that means this one. Empty means this instance always does.
HA_OWNER_ENTITY=
HA_OWNER_VALUE=
# The lights hub (README -> The lights hub). Manual control: an on/off helper; while on, this instance leaves the
# bulbs entirely alone (set it on every instance). Mode: an input_select with exactly the options
# "Follow the screen", "Saved colour", "Saved pattern".
HA_MANUAL_ENTITY=
HA_MODE_ENTITY=
# Screen select (options written by this machine) and status sensor: only on the instance that captures the
# screen, so set them in .env.linux / .env.windows.
HA_SCREEN_ENTITY=
HA_STATUS_ENTITY=
# Every other setting as Home Assistant helpers named <prefix>_*: brightness, colour type, colour, kelvin,
# pattern (one line: "#ff3300 2 1, 2700K 3"), colour engine, one zone select per light and a restart button.
# Letters, digits and _ only; empty mirrors none of them. README -> The lights hub -> Every other setting.
HA_HUB_PREFIX=

# screen, or tv for frames from a rooted LG TV (see the README).
CAPTURE_SOURCE=screen
TV_FRAME_BIND=0.0.0.0
TV_FRAME_PORT=8792
TV_FRAME_SENDER=

# Sync mode: ambience (recommended), zoned, or shared-variant.
# Ambience renders the screen's overall light as a weighted palette across two
# physical groups: a near group beside the screen and a far group in the room.
COLOR_SYNC_MODE=ambience
AMBIENCE_NEAR_LIGHTS=light.example_primary_left,light.example_primary_right
PRIMARY_LIGHT_ZONE_NAMES=top-center,bottom-left
# Default screen to sample: primary, all, or a 1-based monitor index.
# Home Assistant's Screen select (HA_SCREEN_ENTITY) overrides this live; this value
# is the fallback when no screen is picked there (and if the picked one disappears).
# NOTE: indices are per-OS and unrelated. Windows numbers screens in mss
# enumeration order; Linux sorts Mutter's logical monitors by position. On the
# xdg-desktop-portal capture path this is ignored entirely -- the user chooses
# the screen in the consent dialog.
SCREEN_CAPTURE_TARGET=primary

# Optional local RGB extension (see ambience-rgb).
# When enabled, each ambience tick's near/far colours are published for a
# separate program to drive motherboard/AIO/RAM lighting, switched by the RGB
# master switch (HA_RGB_SWITCH_ENTITY). Disabled by default: with it off nothing
# is published and no socket is created. Publishing is fire-and-forget -- if nothing is listening the frame is
# dropped and the lights are unaffected.
#
# RGB_PUBLISH_SOCKET is where the extension listens; `ambience-rgb devices`
# prints the exact value to paste here.
#   Linux    a unix datagram socket path, e.g. /run/user/1000/ambience-rgb.sock
#   Windows  udp://127.0.0.1:45731 -- Windows has no unix datagram sockets
RGB_EXTENSION_ENABLED=false
RGB_PUBLISH_SOCKET=

# Home Assistant and retry behavior
REQUEST_TIMEOUT_SECONDS=3.0
AVAILABILITY_REFRESH_SECONDS=5.0
ERROR_RETRY_SECONDS=5.0

# Update cadence and dispatch
SYNC_INTERVAL_SECONDS=0.2
INTER_LIGHT_DELAY_SECONDS=0.4
MAX_PARALLEL_LIGHT_UPDATES=6
TRANSITION_SECONDS=0.0

# Custom pattern fades use Home Assistant's transition parameter. Many Matter
# bulbs lock up on transition commands, so pattern fades are capped here and are
# OFF by default (patterns snap between colors). Raise this only if your bulbs are
# known to handle fades, e.g. MAX_PATTERN_TRANSITION_SECONDS=2.
MAX_PATTERN_TRANSITION_SECONDS=0.0

# Color tuning
COLOR_CHANGE_THRESHOLD=12
BRIGHTNESS_FLOOR=255
DARK_THRESHOLD=12
DARK_ACTIVE_RATIO_THRESHOLD=0.05
COLOR_BOOST=1.55
SAMPLE_STRIDE=121

# Optional log file override. Leave EMPTY and it resolves per-OS:
#   Windows: %LOCALAPPDATA%\matterlights\matterlights.log
#   Linux:   $XDG_STATE_HOME/matterlights/matterlights.log  (~/.local/state/...)
# An absolute path from one OS is meaningless on the other, so if you keep a
# .env per machine, prefer leaving this blank.
LOG_PATH=
