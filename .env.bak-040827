HA_URL=http://192.168.10.2:8123
# One zone name per light in the same order as HA_LIGHT_ENTITIES.
LIGHT_ZONE_LAYOUT=top-left,top-center,top-right,bottom-right,bottom-center,bottom-left
LIGHT_ZONE_FILE=.matterlights-zones.json
COLOR_SYNC_MODE=ambience
AMBIENCE_NEAR_LIGHTS=light.ledvance_matter_par16_rgbw_2,light.ledvance_matter_par16_rgbw_6
PRIMARY_LIGHT_ZONE_NAMES=top-center,bottom-left
# Linux monitor indices are Mutter's, sorted by position -- unrelated to the
# Windows ones. 'primary' is DP-2 here.
SCREEN_CAPTURE_TARGET=primary
REQUEST_TIMEOUT_SECONDS=3.0
AVAILABILITY_REFRESH_SECONDS=5.0
SYNC_INTERVAL_SECONDS=0.2
HA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiI3NjE1NGZiMjM4ZmM0YTg1OTgyNTIyNGRlMzllZDliYyIsImlhdCI6MTc3OTU3NDc2MywiZXhwIjoyMDk0OTM0NzYzfQ.tHG7JeovpLfSrT86ruMADlt5WDZ_YCwVCE0syeh09q0
BRIGHTNESS_FLOOR=255
INTER_LIGHT_DELAY_SECONDS=0.4
MAX_PARALLEL_LIGHT_UPDATES=6
# Empty: resolves per-OS to $XDG_STATE_HOME/matterlights/matterlights.log
LOG_PATH=
COLOR_CHANGE_THRESHOLD=12
COLOR_BOOST=1.55
DARK_THRESHOLD=12
DARK_ACTIVE_RATIO_THRESHOLD=0.05
SAMPLE_STRIDE=121
TRANSITION_SECONDS=0.0
HA_LIGHT_ENTITIES=light.ledvance_matter_par16_rgbw,light.ledvance_matter_par16_rgbw_2,light.ledvance_matter_par16_rgbw_3,light.ledvance_matter_par16_rgbw_4,light.ledvance_matter_par16_rgbw_5,light.ledvance_matter_par16_rgbw_6
ERROR_RETRY_SECONDS=5.0

# Local RGB extension (linux-rgb)
RGB_EXTENSION_ENABLED=true
RGB_PUBLISH_SOCKET=/run/user/1000/linux-rgb.sock
